# BigWigsMods/packager configuration for full DynamicSuite bundle (Hub + 11 Modules)
# Consolidated single-entry architecture: DynamicSuite/DynamicSuite.toc loads
# DynamicSuite_Core.lua, DynamicSuite_UI.lua, and all 11 Modules\Dynamic*.lua.
package-as: DynamicSuite
enable-nolib-creation: no

manual-changelog:
  filename: .release-changelog.md
  markup-type: markdown

move-folders:
  DynamicSuite/DynamicSuite: DynamicSuite

ignore:
  - "*.ps1"
  - "*.cmd"
  - "*.zip"
  - "*.log"
  - "*.tmp"
  - "*.bak"
  - .gitignore
  - .github
  - .pkgmeta
  - .pkgmeta-dynamicmarker
  - .release-changelog.md
  - AGENTS.md
  - DESIGN_SYSTEM.md
  - TASKS.md
  - Design
  - docs
  - Marketing
  - Packaging
  - Screenshots
  - scripts
